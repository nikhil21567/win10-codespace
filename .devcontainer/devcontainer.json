{
  "name": "Tiny10 - Zero Commands Auto Boot",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [6080],
  "postCreateCommand": "bash scripts/init.sh",
  "postStartCommand": "bash scripts/init.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"],
      "ports": [
        {
          "name": "Tiny10",
          "label": "🖥️ Open Tiny10 Desktop",
          "port": 6080,
          "visibility": "public",
          "protocol": "http"
        }
      ]
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}